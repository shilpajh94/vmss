# Local dev .env — generated from .env.example per README.md's Getting
# Started section. Not committed (gitignored).
#
# Filled in from the "DDEV-default"/"Current default" values documented in
# .env.example's own comments (see fix-visit-info-lookup-access's apply
# session) — this file previously had every value as an unresolved
# __PLACEHOLDER__ token, which blocked Settings() from parsing at all.

APP_NAME="VMSS API"
APP_ENV=local
APP_DEBUG=true

LOG_LEVEL=INFO

DB_USER=db
DB_PASSWORD=db
DB_HOST=db
DB_PORT=5432
DB_NAME=db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=0
REDIS_CELERY_BROKER_DB=1
REDIS_CELERY_RESULT_DB=2
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

JWT_SECRET_KEY=BxHn6b4yxYpXWVoATWvOrYy05rniycfku2Bguoo7iPg_M3YCdDpRpxXMF8KHrh7oN9_zu8-KPlxvtvwohPOBEA
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

TENANT_DEFAULT_SLUG=default
TENANT_GLOBAL_SCHEMA_NAME=global
TENANT_SCHEMA_PREFIX=tenant_
STORAGE_ROOT=./var/storage
