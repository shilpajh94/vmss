# Template only. Copy to `.env` at this repo's root (gitignored) and fill in
# real values there — never here. This file is committed; `.env` is not.

# The core-api service (VMMS_API repo), not this web app. Under VMMS_API's
# own DDEV project that is https://vmss-api.ddev.site:8453 (http on 8010);
# under a bare `uvicorn` it is http://localhost:8000. Port 3001/3010 below
# is THIS app's own DDEV project -- pointing VITE_API_BASE_URL at those
# sends the app's API calls back at itself.
VITE_API_BASE_URL=https://vmss-api.ddev.site:8453

# Entra ID (MSAL) staff SSO app registration — placeholders only. A client ID
# and tenant ID are public OAuth identifiers rather than secrets (the SPA
# ships them in its bundle), but a real tenant ID still identifies the
# customer organisation, so it does not belong in a committed file.
VITE_ENTRA_CLIENT_ID=0786c0f1-e333-4206-bba9-9f61eddcb66f
VITE_ENTRA_TENANT_ID=192a4d7a-44fa-49f4-b052-b8e88940ae49

# Must byte-for-byte match a redirect URI registered under the "Single-page
# application" platform (NOT "Web" — a Web-platform registration fails token
# redemption with AADSTS9002326). A staff route, deliberately: the OAuth
# response should not land on /portal/{slug}, which is the unauthenticated
# visitor surface.
VITE_ENTRA_REDIRECT_URI=https://vmss-web.ddev.site:3001

# Optional, single-tenant-deployment convenience only. The architecture is
# strictly path-based multi-tenancy (/portal/{tenant_slug} per
# docs/plans/US-11.md, US-13a.md, ADR-004) -- leave this unset for any
# deployment serving more than one tenant. When set, the bare app root ("/")
# renders that tenant's portal directly instead of the staff sign-in shell;
# staff still sign in at /staff.
# VITE_DEFAULT_TENANT_SLUG=acme-corp
