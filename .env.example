# Every value below is a __PLACEHOLDER__ token, not a usable default —
# fill in a real value for each before running the app. Where DDEV's own
# service topology fixes the correct value (Postgres/Redis hosts, etc.), the
# comment above that line states it verbatim so you can paste it in rather
# than re-deriving it. See README.md's Getting Started section.

# DDEV-default: "VMSS API"
APP_NAME=__APP_NAME__
# DDEV-default: local
APP_ENV=__APP_ENV__
# DDEV-default: true
APP_DEBUG=__APP_DEBUG__

# Current default: INFO. Raise to DEBUG for local diagnosis only — never in
# staging/prod by default (logging-observability.md §3).
LOG_LEVEL=__LOG_LEVEL__
# DDEV's Postgres service defaults to db/db/db on host "db" — split into
# separate vars (rather than one DATABASE_URL) so a password containing a
# reserved URL character (@, :, /, %) can't corrupt the parsed host/port;
# core/config.py assembles and percent-encodes the connection URL from these.
# DDEV-default: db
DB_USER=db
# DDEV-default: db
DB_PASSWORD=db
# DDEV-default: db
DB_HOST=db
# DDEV-default: 5432
DB_PORT=5432
# DDEV-default: db
DB_NAME=db



# Redis — one shared instance, one logical DB index per purpose. If any of
# REDIS_URL/CELERY_BROKER_URL/CELERY_RESULT_BACKEND is set, it wins outright
# for that one purpose only.
# DDEV's ddev-redis add-on exposes Redis at redis:6379 —
# DDEV-default: redis
REDIS_HOST=__REDIS_HOST__
# DDEV-default: 6379
REDIS_PORT=__REDIS_PORT__
# Leave genuinely blank if Redis has no auth configured (DDEV's default).
REDIS_PASSWORD=
# Current default: 0
REDIS_CACHE_DB=__REDIS_CACHE_DB__
# Current default: 1
REDIS_CELERY_BROKER_DB=__REDIS_CELERY_BROKER_DB__
# Current default: 2
REDIS_CELERY_RESULT_DB=__REDIS_CELERY_RESULT_DB__
# Leave genuinely blank unless overriding one purpose's connection
# individually — see the precedence note above.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Generate a real secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=__JWT_SECRET_KEY__
# Current default: HS256
JWT_ALGORITHM=__JWT_ALGORITHM__
# Current default: 30
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=__JWT_ACCESS_TOKEN_EXPIRE_MINUTES__
# Current default: 10080
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=__JWT_REFRESH_TOKEN_EXPIRE_MINUTES__

# Current default: ["http://localhost:3000"]
CORS_ALLOWED_ORIGINS=__CORS_ALLOWED_ORIGINS__

# Current default: default
TENANT_DEFAULT_SLUG=__TENANT_DEFAULT_SLUG__

# See database-architecture.md §2 — the global schema holds cross-tenant
# registry tables; every tenant gets its own `{TENANT_SCHEMA_PREFIX}{slug}` schema.
# Current default: global
TENANT_GLOBAL_SCHEMA_NAME=__TENANT_GLOBAL_SCHEMA_NAME__
# Current default: tenant_
TENANT_SCHEMA_PREFIX=__TENANT_SCHEMA_PREFIX__

# Local-disk storage root for uploaded files (dev only — see
# database-architecture.md §1 for the prod object-storage swap).
# Current default: ./var/storage
STORAGE_ROOT=__STORAGE_ROOT__
# "local" (default, disk-backed) or "s3" (API-14) — see
# add-walkin-visitor-registration/design.md Decision 4.
# Current default: local
STORAGE_BACKEND=__STORAGE_BACKEND__
# Required when STORAGE_BACKEND=s3. AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# are read directly by boto3's default credential provider chain — not a
# Settings field — so those two exact names matter. AWS_DEFAULT_REGION is
# also boto3's own env var, used automatically when STORAGE_S3_REGION below
# is left blank. Leave all genuinely blank when STORAGE_BACKEND=local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# The bucket name and (for a non-AWS S3-compatible provider, e.g. MinIO) the
# endpoint URL are read through `Settings`, not boto3's chain, since boto3
# has no env var of its own for either. Leave STORAGE_S3_ENDPOINT_URL
# genuinely blank to use AWS's default endpoint resolution.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT_URL=
# Current default: 300
STORAGE_S3_PRESIGNED_URL_TTL_SECONDS=__STORAGE_S3_PRESIGNED_URL_TTL_SECONDS__

# Mail — defaults target a local dev mail-catcher (e.g. mailhog/mailpit).
# DDEV-default: localhost
MAIL_HOST=__MAIL_HOST__
# DDEV-default: 1025
MAIL_PORT=__MAIL_PORT__
# Leave genuinely blank (no placeholder) unless the mail-catcher needs auth —
# MAIL_USERNAME/MAIL_PASSWORD present-but-empty vs. absent is NOT the same
# to pydantic-settings, and aiosmtplib attempts an AUTH login the moment
# either is a non-empty string (including a literal, un-filled-in
# placeholder token), which mailpit/mailhog reject outright. See the fix in
# openspec/changes/archive/2026-08-18-pre-commit-quality-audit/design.md.
MAIL_USERNAME=
MAIL_PASSWORD=
# Current default: false
MAIL_USE_TLS=__MAIL_USE_TLS__
# Current default: no-reply@vmss.local
MAIL_FROM_ADDRESS=__MAIL_FROM_ADDRESS__

# SMS gateway — no vendor chosen yet; leave genuinely blank (no placeholder)
# until one is picked — same "absent, not empty-string" reasoning as
# MAIL_USERNAME/MAIL_PASSWORD above applies here too
# (see openspec/changes/add-pre-registration/design.md's Open Questions).
SMS_GATEWAY_BASE_URL=
SMS_GATEWAY_API_KEY=
SMS_FROM_NUMBER=

# Pre-registration invitations (API-09-12).
# Current default: 168
INVITATION_TOKEN_TTL_HOURS=__INVITATION_TOKEN_TTL_HOURS__
# Current default: 5242880
INVITATION_MAX_UPLOAD_SIZE_BYTES=__INVITATION_MAX_UPLOAD_SIZE_BYTES__
# Current default: 20
INVITATION_MAX_GROUP_VISITORS=__INVITATION_MAX_GROUP_VISITORS__

# QR check-in token encryption. Leave genuinely blank only if no invitation
# will be approved yet — the first QR token generation fails loudly without
# it. Deliberately a separate key from SSO_ENCRYPTION_KEY below. Generate
# one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QR_TOKEN_ENCRYPTION_KEY=

# Walk-in registration (API-13) fallback branch when no X-Device-Key is
# presented. Current default: MAIN
REGISTRATION_DEFAULT_BRANCH_CODE=__REGISTRATION_DEFAULT_BRANCH_CODE__

# Identity verification OTP (API-15). Current defaults: 300/6/5/5/3600.
OTP_TTL_SECONDS=__OTP_TTL_SECONDS__
OTP_LENGTH=__OTP_LENGTH__
OTP_MAX_ATTEMPTS=__OTP_MAX_ATTEMPTS__
OTP_RATE_LIMIT_PER_IDENTIFIER=__OTP_RATE_LIMIT_PER_IDENTIFIER__
OTP_RATE_LIMIT_WINDOW_SECONDS=__OTP_RATE_LIMIT_WINDOW_SECONDS__

# Twilio — SMS provider for identity-verification OTP delivery. Leave
# genuinely blank (no placeholder) to leave SMS unconfigured — same
# "absent, not empty-string" reasoning as MAIL_USERNAME/PASSWORD above; the
# sender falls back to a loud "not configured" error rather than a false
# success.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=

# WhatsApp gateway — no vendor chosen yet; leave genuinely blank, same
# posture SMS_GATEWAY_* had before Twilio was picked for SMS.
WHATSAPP_GATEWAY_BASE_URL=
WHATSAPP_GATEWAY_API_KEY=

# Staff SSO (OIDC) login (API-19). Leave SSO_ENCRYPTION_KEY genuinely blank
# only if no tenant will configure SSO yet — the first save of an SSO
# provider config fails loudly without it, rather than storing the client
# secret unencrypted. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SSO_ENCRYPTION_KEY=
# The exact redirect URI registered with every tenant's IdP app
# registration — e.g. https://api.example.com/api/v1/auth/sso/callback.
# Must match exactly what's configured on the IdP side; leave genuinely
# blank until it's registered there.
SSO_REDIRECT_URI=
# Where the browser is redirected after a successful IdP login, with a
# short-lived exchange code appended as ?code=... — e.g. https://portal.example.com/sso/callback.
# Leave genuinely blank until the React portal's callback route exists.
SSO_FRONTEND_CALLBACK_URL=
# Current default: 60
SSO_EXCHANGE_CODE_TTL_SECONDS=__SSO_EXCHANGE_CODE_TTL_SECONDS__
# Current default: 600
SSO_STATE_TTL_SECONDS=__SSO_STATE_TTL_SECONDS__

# Firebase Cloud Messaging — push provider for staff notifications on both
# the React portal (FCM Web Push) and the Flutter app (API-XX,
# add-invitation-push-notifications). Path to a service-account key JSON
# file. Leave genuinely blank (no placeholder) until one is generated in the
# Firebase console — same "absent, not empty-string" reasoning as
# MAIL_USERNAME/TWILIO_* above; push dispatch fails loudly rather than
# silently no-op'ing when left unset.
FCM_CREDENTIALS_PATH=
