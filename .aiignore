# Files that shouldn't be fed into AI tool context: secrets, generated/cache
# noise, and reviewed-not-authored content. Mirrors .gitignore where it
# overlaps, plus a few extras that are tracked in git but low-signal for an
# AI assistant to read.

# Secrets — never let these into a model's context.
.env
.env.*
!.env.example

# Dependency/interpreter noise.
.venv/
.python-version
uv.lock

# Caches and bytecode.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Autogenerated migrations — reviewed, not hand-authored (see
# database-architecture.md §5 / pyproject.toml's ruff extend-exclude for the
# same reasoning).
alembic/versions/
alembic_tenant/versions/

# Large reference material better read on request than loaded by default.
*.pdf

# DDEV/editor/local machinery, not application code.
.ddev/
.vscode/
.idea/
